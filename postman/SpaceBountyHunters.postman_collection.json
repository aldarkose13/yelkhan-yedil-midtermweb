{
  "info": {
    "name": "Space Bounty Hunters API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "huntId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Wanted Criminals",
      "item": [
        {
          "name": "List all criminals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: min_reward=5000 & armed=true, sort=-reward",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/?min_reward=5000&armed=true&sort=-reward",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals"
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "5000"
                },
                {
                  "key": "armed",
                  "value": "true"
                },
                {
                  "key": "sort",
                  "value": "-reward"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const d = pm.response.json();",
                  "pm.test('All armed, reward >= 5000, sorted desc', function () {",
                  "  pm.expect(d.every(c => c.armed && c.reward >= 5000)).to.be.true;",
                  "  for (let i = 1; i < d.length; i++) pm.expect(d[i-1].reward).to.be.at.least(d[i].reward);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: reward range + escape_master",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/?min_reward=5000&max_reward=30000&escape_master=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals"
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "5000"
                },
                {
                  "key": "max_reward",
                  "value": "30000"
                },
                {
                  "key": "escape_master",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: has_crew=true, sort=reward (ascending)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/?has_crew=true&sort=reward",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals"
              ],
              "query": [
                {
                  "key": "has_crew",
                  "value": "true"
                },
                {
                  "key": "sort",
                  "value": "reward"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Criminal details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/1/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Hunt Logs (CRUD)",
      "item": [
        {
          "name": "List all hunt logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List hunt logs for criminal 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/?criminal_id=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts"
              ],
              "query": [
                {
                  "key": "criminal_id",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create hunt log",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 3,\n  \"success\": false,\n  \"notes\": \"Target escaped through an asteroid field.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('huntId', d.id);",
                  "pm.test('created_at generated by server', function () { pm.expect(d.created_at).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get created hunt log",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{huntId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{huntId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update hunt log (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{huntId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{huntId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"success\": true,\n  \"notes\": \"Captured on the second attempt.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Updated', function () { pm.expect(pm.response.json().success).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete hunt log",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{huntId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{huntId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get deleted hunt log (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{huntId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{huntId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Invalid Requests",
